<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>KoobalSearchEngine</AssemblyName>
    <RootNamespace>PartSearchSuggest</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.8.5.7</Version>
    <AssemblyVersion>0.8.5.7</AssemblyVersion>
    <FileVersion>0.8.5.7</FileVersion>
    <InformationalVersion>0.8.5.3b</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <NoWarn>MSB3277</NoWarn>
    <Configurations>Debug;Release;ReleaseV09</Configurations>
    <KSPRoot Condition="'$(KSPRoot)' == ''">$(MSBuildThisFileDirectory)..\..\</KSPRoot>
    <OutputPath>$(KSPRoot)GameData\KoobalSearchEngine\Plugins\</OutputPath>
  </PropertyGroup>

  <!-- 1.0.0 ship: define KOOBAL_V09 (scroll-recycle). Set KSPRoot to your KSP install. -->
  <PropertyGroup Condition="'$(Configuration)' == 'ReleaseV09'">
    <DefineConstants>$(DefineConstants);KOOBAL_V09</DefineConstants>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <KspDir>$(KSPRoot)</KspDir>
    <KspManaged>$(KspDir)KSP_x64_Data\Managed\</KspManaged>
    <KspGameData>$(KspDir)GameData\</KspGameData>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tools/**" />
    <Compile Remove="obj/**" />
    <Compile Remove="ReleaseArchive/**" />
    <!-- Post-v1 architecture scaffolding only — do not ship until after v1. See PostV1/README.md -->
    <Compile Remove="PostV1\**\*.cs" />
    <None Remove="tools/**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(KspManaged)Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(KspGameData)000_Harmony\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(KspManaged)UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KspManaged)UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(KspManaged)UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(KspManaged)UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(KspManaged)UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextCoreModule">
      <HintPath>$(KspManaged)UnityEngine.TextCoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(KspManaged)UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(KspManaged)UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
